{
  "name": "topnote-promo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TopNotePromo ../media/TopNote-promo.mp4 --codec h264 --crf 20 --concurrency 4",
    "poster": "remotion still src/index.ts TopNotePromo ../media/TopNote-poster.png --frame 285",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.528",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
