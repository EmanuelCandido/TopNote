{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopNote",
  "version": "0.1.3",
  "identifier": "com.topnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TopNote",
        "width": 660,
        "height": 638,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "create": false
      },
      {
        "label": "capsule",
        "title": "TopNote",
        "url": "index.html?capsule=1",
        "width": 240,
        "height": 52,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "create": false
      },
      {
        "label": "dialog",
        "title": "TopNote",
        "url": "index.html?dialog=1",
        "width": 540,
        "height": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "create": false
      },
      {
        "label": "projects",
        "title": "TopNote · Projetos",
        "url": "index.html?projects=1",
        "width": 231,
        "height": 360,
        "minWidth": 210,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/attachments/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Notas rápidas sempre ao alcance",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
